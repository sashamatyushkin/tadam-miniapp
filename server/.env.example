# Токен бота из @BotFather. Не коммитить, не пересылать в чаты.
BOT_TOKEN=
# Адрес фронтенда (Mini App) — со слешем на конце
WEBAPP_URL=https://sashamatyushkin.github.io/tadam-miniapp/
# Порт API внутри сервера (снаружи — через nginx/Caddy с HTTPS)
PORT=8787
# production — выключает временные туннели cloudflared в CORS
NODE_ENV=production
# Домены фронтенда, которым разрешено ходить в API (через запятую)
ALLOWED_ORIGINS=https://sashamatyushkin.github.io
# 1 — разрешить выдачу premium без оплаты (только для теста!). На проде — 0
ALLOW_TEST_PAYMENTS=0
